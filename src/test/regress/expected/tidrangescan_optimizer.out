-- tests for tidrangescans
SET enable_seqscan TO off;
CREATE TABLE tidrangescan(id integer, data text, seg_id integer default 0) DISTRIBUTED BY (seg_id);
-- empty table
EXPLAIN (COSTS OFF)
SELECT ctid FROM tidrangescan WHERE ctid < '(1, 0)' AND gp_segment_id >= 0;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on tidrangescan
         Filter: ((ctid < '(1,0)'::tid) AND (gp_segment_id >= 0))
 Optimizer: Pivotal Optimizer (GPORCA)
(4 rows)

SELECT ctid FROM tidrangescan WHERE ctid < '(1, 0)' AND gp_segment_id >= 0;
 ctid 
------
(0 rows)

EXPLAIN (COSTS OFF)
SELECT ctid FROM tidrangescan WHERE ctid > '(9, 0)' AND gp_segment_id >= 0;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on tidrangescan
         Filter: ((ctid > '(9,0)'::tid) AND (gp_segment_id >= 0))
 Optimizer: Pivotal Optimizer (GPORCA)
(4 rows)

SELECT ctid FROM tidrangescan WHERE ctid > '(9, 0)' AND gp_segment_id >= 0;
 ctid 
------
(0 rows)

-- insert enough tuples to fill at least two pages
INSERT INTO tidrangescan SELECT i,repeat('x', 100) FROM generate_series(1,2000) AS s(i);
-- remove all tuples after the 10th tuple on each page.  Trying to ensure
-- we get the same layout with all CPU architectures and smaller than standard
-- page sizes.
DELETE FROM tidrangescan
WHERE (substring(ctid::text FROM ',(\d+)\)')::integer > 10 OR substring(ctid::text FROM '\((\d+),')::integer > 2) AND gp_segment_id >= 0;
VACUUM tidrangescan;
-- range scans with upper bound
EXPLAIN (COSTS OFF)
SELECT ctid FROM tidrangescan WHERE ctid < '(1,0)' AND gp_segment_id >= 0;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on tidrangescan
         Filter: ((ctid < '(1,0)'::tid) AND (gp_segment_id >= 0))
 Optimizer: Pivotal Optimizer (GPORCA)
(4 rows)

