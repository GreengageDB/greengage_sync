-- range scans with both bounds
EXPLAIN (COSTS OFF)
SELECT ctid FROM tidrangescan WHERE ctid > '(1,4)' AND '(1,7)' >= ctid AND gp_segment_id >= 0;
                                         QUERY PLAN                                          
---------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on tidrangescan
         Filter: ((ctid > '(1,4)'::tid) AND (ctid <= '(1,7)'::tid) AND (gp_segment_id >= 0))
 Optimizer: Pivotal Optimizer (GPORCA)
(4 rows)

SELECT ctid FROM tidrangescan WHERE ctid > '(1,4)' AND '(1,7)' >= ctid AND gp_segment_id >= 0;
